# ==== Postgres (pgvector) ====
POSTGRES_USER=argi
POSTGRES_PASSWORD=argi_dev_password
POSTGRES_DB=argi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by the backend (host = docker service name "db")
DATABASE_URL=postgresql+asyncpg://argi:argi_dev_password@db:5432/argi

# ==== JWT / Auth ====
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== LLM: OpenRouter (default chat provider) ====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==== LLM: Ollama (optional secondary provider) ====
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ==== Embeddings for pgvector long-term memory ====
# Providers: "fake" (deterministic, offline, zero-dep) | "ollama"
EMBEDDINGS_PROVIDER=fake
EMBEDDING_DIM=768
OLLAMA_EMBED_MODEL=nomic-embed-text

# ==== Agent memory tuning ====
HISTORY_LIMIT=40
MEMORY_TOP_K=5

# ==== Frontend ====
# Browser-visible URL of the backend API.
# docker-compose maps the backend to host port 8080 (container 8000) and
# Postgres to host 5433, to avoid clashing with other local services.
NEXT_PUBLIC_API_URL=http://localhost:8080
