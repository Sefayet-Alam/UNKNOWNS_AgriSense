# ==== Postgres (pgvector) ====
POSTGRES_USER=argi
POSTGRES_PASSWORD=argi_dev_password
POSTGRES_DB=argi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by the backend (host = docker service name "db")
DATABASE_URL=postgresql+asyncpg://argi:argi_dev_password@db:5432/argi

# ==== JWT / Auth ====
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== LLM: OpenRouter (default chat provider) ====
OPENROUTER_API_KEY=
# gemini-2.5-flash: strongest Bengali/Banglish + reliable tool calling (see docs/PLAN.md D2)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free  # google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==== LLM: OpenAI (embedding model provider) ====
OPENAI_API_KEY=xxxxxxxx
OPENAI_EMBED_MODEL=text-embedding-3-small

# ==== LLM: Ollama (optional secondary provider) ====
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ==== Embeddings for pgvector long-term memory ====
# Providers: "fake" (deterministic, offline, zero-dep) | "ollama"
EMBEDDINGS_PROVIDER=fake
EMBEDDING_DIM=768
OLLAMA_EMBED_MODEL=nomic-embed-text

# ==== Knowledge base (RAG) ====
# Providers: "openai" (text-embedding-3-small, needs OPENAI_API_KEY) |
# "ollama" | "fake" (offline tests). Dim is baked into the pgvector column
# (migration 0003) — changing model/dim needs a new migration + re-ingest.
KB_EMBEDDINGS_PROVIDER=openai
KB_EMBEDDING_DIM=1536
KB_TOP_K=5
KB_CHUNK_SIZE_CHARS=1800
KB_CHUNK_OVERLAP_CHARS=200

# ==== Agent memory tuning ====
HISTORY_LIMIT=40
MEMORY_TOP_K=5

# ==== Frontend ====
# Browser-visible URL of the backend API.
# docker-compose maps the backend to host port 8080 (container 8000) and
# Postgres to host 5433, to avoid clashing with other local services.
NEXT_PUBLIC_API_URL=http://localhost:8080
