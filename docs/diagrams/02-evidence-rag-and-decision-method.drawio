        <mxCell id="title" value="AgriSense: RAG System and Tool Calls" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#173B2B;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="800" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Every response is grounded through controlled tool calls; the model orchestrates and explains rather than calculating freely." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B66;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="1100" height="25" as="geometry"/></mxCell>

