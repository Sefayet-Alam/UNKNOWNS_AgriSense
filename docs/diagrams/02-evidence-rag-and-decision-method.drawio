        <mxCell id="orchestrate" value="&lt;b&gt;LangGraph specialist routing&lt;/b&gt;&lt;br&gt;Identifies the request, loads context and invokes only required tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6DB0;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="decisionZone"><mxGeometry x="145" y="50" width="230" height="65" as="geometry"/></mxCell>
