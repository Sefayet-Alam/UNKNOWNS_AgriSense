        <mxCell id="guardrail" value="&lt;b&gt;Safety and honesty guardrail&lt;/b&gt;&lt;br&gt;Retrieved text is untrusted reference material. The model never invents operational values; unavailable sources return a clearly degraded response." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEEEE;strokeColor=#C65959;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="answerZone"><mxGeometry x="75" y="390" width="420" height="105" as="geometry"/></mxCell>

