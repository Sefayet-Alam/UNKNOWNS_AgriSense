  <diagram id="agrisense-workflow" name="AgriSense workflow">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AgriSense: Overall Methodology (Tier 0 + Tier 1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#173B2B;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1050" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="The assistant converts farm context into transparent, practical decisions. BDApps integration is intentionally excluded from this presentation." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B66;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="1200" height="25" as="geometry"/></mxCell>

        <mxCell id="farmerZone" value="Farmer experience" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#EAF5EE;swimlaneFillColor=#D5ECDD;strokeColor=#5C9B73;fontStyle=1;fontColor=#173B2B;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="225" height="600" as="geometry"/></mxCell>
        <mxCell id="farmer" value="&lt;b&gt;Farmer&lt;/b&gt;&lt;br&gt;Crop, location, land, soil, water, budget and goals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C9B73;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="farmerZone"><mxGeometry x="25" y="60" width="175" height="90" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Next.js chat interface&lt;/b&gt;&lt;br&gt;Guided intake, answer cards, plans, citations and tool trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C9B73;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="farmerZone"><mxGeometry x="25" y="205" width="175" height="100" as="geometry"/></mxCell>
        <mxCell id="outcome" value="&lt;b&gt;Actionable response&lt;/b&gt;&lt;br&gt;Recommendation, calendar, costs, warnings and next steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF7E7;strokeColor=#D5A928;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="farmerZone"><mxGeometry x="25" y="405" width="175" height="95" as="geometry"/></mxCell>

        <mxCell id="apiZone" value="Application boundary" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#EAF1FB;swimlaneFillColor=#D8E6F8;strokeColor=#5A86B5;fontStyle=1;fontColor=#173B2B;" vertex="1" parent="1"><mxGeometry x="320" y="125" width="230" height="600" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;FastAPI API&lt;/b&gt;&lt;br&gt;Authenticated chat and farm endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A86B5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="apiZone"><mxGeometry x="25" y="90" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="sse" value="&lt;b&gt;Streaming response&lt;/b&gt;&lt;br&gt;SSE tokens + visible tool trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A86B5;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="apiZone"><mxGeometry x="25" y="300" width="180" height="75" as="geometry"/></mxCell>

        <mxCell id="agentZone" value="LangGraph decision workflow" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#F4EEF9;swimlaneFillColor=#E9DCF4;strokeColor=#9A6DB0;fontStyle=1;fontColor=#3E2750;" vertex="1" parent="1"><mxGeometry x="595" y="125" width="400" height="600" as="geometry"/></mxCell>
        <mxCell id="route" value="&lt;b&gt;Intent and context routing&lt;/b&gt;&lt;br&gt;Selects the specialist path from the farmer's request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6DB0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="agentZone"><mxGeometry x="105" y="55" width="190" height="75" as="geometry"/></mxCell>
        <mxCell id="tier0" value="&lt;b&gt;Tier 0: farm planning&lt;/b&gt;&lt;br&gt;Intake - Crop recommender - Season planner - Finance advisor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6DB0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="agentZone"><mxGeometry x="55" y="185" width="290" height="95" as="geometry"/></mxCell>
        <mxCell id="tier1" value="&lt;b&gt;Tier 1: proactive resilience&lt;/b&gt;&lt;br&gt;Pest and disease risk - Weather alerts - Water scheduling - Scenario analysis - Persistent memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E6;strokeColor=#D58B31;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="agentZone"><mxGeometry x="55" y="355" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="compose" value="&lt;b&gt;Grounded answer composer&lt;/b&gt;&lt;br&gt;Explains recommendation, citations, assumptions and alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6DB0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="agentZone"><mxGeometry x="105" y="520" width="190" height="65" as="geometry"/></mxCell>

        <mxCell id="evidenceZone" value="Evidence and calculation layer" style="swimlane;html=1;rounded=1;startSize=28;horizontal=1;fillColor=#EEF6F7;swimlaneFillColor=#D9ECEE;strokeColor=#4C9AA0;fontStyle=1;fontColor=#173B2B;" vertex="1" parent="1"><mxGeometry x="1040" y="125" width="505" height="600" as="geometry"/></mxCell>
        <mxCell id="live" value="&lt;b&gt;Live authoritative sources&lt;/b&gt;&lt;br&gt;Open-Meteo forecast and BARC CZIS crop, variety and fertilizer suitability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9AA0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="evidenceZone"><mxGeometry x="25" y="55" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="rag" value="&lt;b&gt;Agronomy RAG&lt;/b&gt;&lt;br&gt;FRG 2024 and BAMIS reference knowledge with page-level citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9AA0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="evidenceZone"><mxGeometry x="275" y="55" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="engines" value="&lt;b&gt;Deterministic engines&lt;/b&gt;&lt;br&gt;Crop ranking, calendar, fertilizer, finance, pest-risk, water balance and scenario calculations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9AA0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="evidenceZone"><mxGeometry x="70" y="255" width="365" height="105" as="geometry"/></mxCell>
        <mxCell id="state" value="&lt;b&gt;PostgreSQL + pgvector&lt;/b&gt;&lt;br&gt;Farm profiles, plans, chat history, long-term memory, weather alerts and knowledge chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C9AA0;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="evidenceZone"><mxGeometry x="70" y="440" width="365" height="85" as="geometry"/></mxCell>

        <mxCell id="principle" value="&lt;b&gt;Grounding principle:&lt;/b&gt; the LLM routes, retrieves and explains; tools and deterministic engines supply the actual agronomic and financial values. Every response discloses source quality and degrades honestly when a source is unavailable." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B2B;strokeColor=#173B2B;fontColor=#FFFFFF;fontSize=12;align=left;spacingLeft=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="775" width="1495" height="85" as="geometry"/></mxCell>

